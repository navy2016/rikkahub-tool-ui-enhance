+/** The bounded row list keeps observable Text, not an old frame/pass or a second scroll owner. */
+private fun terminalFullVirtualPhysicalItems(
+    screen: List<TerminalRenderedRowState>,
+    style: TextStyle,
+    metric: Any,
+    measurements: TerminalLazyItemMeasurements,
+    selection: TerminalVirtualSelectionUi,
+): LazyListScope.() -> Unit = {
+    items(count = screen.size, key = { index -> screen[index].lineId },
+        contentType = { "terminal-virtual-row" }) { index ->
+        val row = screen[index]
+        key(metric, row.lineId) {
+            TerminalVirtualSelectableRow(selection, index, row, style, metric, measurements, false)
+        }
+    }
+    item(key = TERMINAL_LAZY_TAIL_KEY, contentType = "terminal-tail") {
+        Spacer(Modifier.height(8.dp))
+    }
+}
